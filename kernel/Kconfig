menu "IDT"

menu "Exceptions"

config EXCEPTIONS_NESTING_THRESHOLD
	int "Exceptions nesting threshold"
	default 3

config EXCEPTIONS_RUN_DEBUGGER
	bool "Run the debugger when an exception occurs"
	default n

menu "Default menu"

config EXCEPTION_SHOW_DEFAULT_MENU
	bool "Show the default menu"
	default n

config EXCEPTION_DEFAULT
	int "Default menu" if EXCEPTION_SHOW_DEFAULT_MENU
	default 1 if EXCEPTION_SHOW_DEFAULT_MENU
	range 0 5 if EXCEPTION_SHOW_DEFAULT_MENU
	help
		0: DISASM ONLY
		1: EXCEPTION ONLY
		2: MEMVIEW ONLY
		3: DISASM + EXCEPTION
		4: MEMVIEW + EXCEPTION
		5: STACKTRACE

endmenu # Default menu

config EXCEPTION_DEBUGGER_SYNTAX
	bool "Use Intel Syntax"
	default y
	help
		Intel syntax V. AT&T Syntax... Who wins? Intel ofc :>

config DISASM_STOP_AT_RET
	bool "Make the disassembler stop at any kind of return"
	default n
	help
		If enabled the disassembler will stop showing more disassembly and will stop at the ret instruction
		This includes all of the following instructions:
		- RET
		- IRET
		- IRETQ
		- SYSRET
		- SYSRETQ

endmenu # Exceptions

endmenu # IDT

