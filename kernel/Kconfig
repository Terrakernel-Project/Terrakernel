menu "Timers"

menu "PIT - Deprecated (Unused)"

config PIT_FREQUENCY
	int "PIT Timer Frequency"
	default 25

endmenu # PIT

menu "APIC Timer"

config FALLBACK_TO_PIT
	bool "Fallback to PIT if APIC not available"
	default y

config APIC_INACCURACY_PROT
	bool "APIC inaccuracy protection"
	default n
	help
		Enabled: improves accuracy of the APIC timer
		Disabled: improves boot time, by a couple of milliseconds
		The higher the more accurate the timer is, can range from 1 millisecond to 10 seconds

config APIC_INACCURACY_PROT_DELAY
	int "Delay in milliseconds" if APIC_INACCURACY_PROT
	range 40 400 if APIC_INACCURACY_PROT # 40 millisecond to 400 milliseconds, the higher to more accurate, i think if TK is a real-time OS then higher is better
	default 40 if APIC_INACCURACY_PROT

endmenu # APIC Timer

endmenu # Timers

